# Developer machine only. Do not expose the API on a public interface.
DEVELOPER_MODE=true
API_RUNTIME=local
DATABASE_URL=postgresql://vct:<local-password>@127.0.0.1:5432/vct
QUEUE_TRANSPORT=azure
API_INTERNAL_ORIGIN=http://127.0.0.1:8000
# Server processes only. Fill these in .env; never put secrets in browser config.
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE=
# In Azure use managed identity and the namespace instead of a connection string.
AZURE_SERVICE_BUS_NAMESPACE=
WORKER_MODE=combined
# Durable processing limits. Values are validated at startup.
PROCESSING_MAX_ATTEMPTS=5
PROCESSING_LEASE_SECONDS=300
AZURE_LOCK_RENEWAL_SECONDS=300
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_BASE_BACKOFF_SECONDS=2
OUTBOX_MAX_BACKOFF_SECONDS=60
# Temporary development admission guardrails per rolling fixed UTC window.
# A browser can clear its cookie, so the shared guest cap bounds total guest work.
GUEST_BROWSER_LIMIT=3
GUEST_GLOBAL_LIMIT=100
CUSTOMER_LIMIT=20
ADMISSION_WINDOW_SECONDS=86400
# The web route sets a 30-day opaque HttpOnly, SameSite=Lax guest cookie.
# HTTPS requests also mark it Secure. Clearing it does not reset the shared cap.
# Clerk CLI writes these two values to the ignored .env.clerk file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM public key for networkless token verification.
CLERK_JWT_KEY=
# Keep the audience synchronized with Clerk Dashboard > Sessions > Customize session token.
CLERK_AUDIENCE=vct-connect-api
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:3000,http://localhost:3000
# Optional override. When omitted, the issuer is derived from the publishable key.
CLERK_ISSUER=
