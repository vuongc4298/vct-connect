# Developer machine only. Do not expose the API on a public interface.
DEVELOPER_MODE=true
API_RUNTIME=local
DATABASE_URL=postgresql://vct:<local-password>@127.0.0.1:5432/vct
QUEUE_TRANSPORT=azure
API_INTERNAL_ORIGIN=http://127.0.0.1:8000
# Server processes only. Fill these in .env; never put secrets in browser config.
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE=
# In Azure use managed identity and the namespace instead of a connection string.
AZURE_SERVICE_BUS_NAMESPACE=
# Story 3.1+ intelligence. Azure reads the key from Key Vault.
YESCALE_API_KEY=
# Pinned chat candidate until the human benchmark selects a production model.
YESCALE_MODEL=gpt-4o-mini
# Story 3.3 embedding candidate is intentionally operator-selected.
YESCALE_EMBEDDING_MODEL=
WORKER_MODE=combined
PROCESSING_MAX_ATTEMPTS=5
PROCESSING_LEASE_SECONDS=300
AZURE_LOCK_RENEWAL_SECONDS=300
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_BASE_BACKOFF_SECONDS=2
OUTBOX_MAX_BACKOFF_SECONDS=60
GUEST_BROWSER_LIMIT=3
GUEST_GLOBAL_LIMIT=100
CUSTOMER_LIMIT=20
ADMISSION_WINDOW_SECONDS=86400
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUDIENCE=vct-connect-api
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:3000,http://localhost:3000,chrome-extension://klggcepemjjbphjclpiabgpfgdbgiljj
CLERK_ISSUER=
